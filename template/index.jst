

var config = require("./_config.js");

var Tgati = require("./googleAnalytics.jst");

var assetsFolder = config.assetsFolder;


function build(ctx, menu, content){

	// A real description matters more than it looks: it is what search engines and
	// retrieval systems quote. The old hard-coded "Generated by Documon" string told a
	// reader nothing about the project being documented.
	var indexDescription = (ctx.projectDescription || "").replace(/"/g, "&quot;").trim()
		|| ("API documentation for " + ctx.projectName
			+ (ctx.projectVersion ? " v" + ctx.projectVersion : "") + ".");

	var canonical = ctx.baseUrl
		? '<link rel="canonical" href="' + ctx.baseUrl.replace(/\/+$/, "") + '/index.html">'
		: "";

	// The docs root, described. Content pages carry an APIReference node each; this is
	// the site they belong to, so a crawler that starts here knows what it has found.
	// No timestamp: two builds of unchanged sources must produce identical output.
	var siteNode = {
		  "@context"    : "https://schema.org"
		, "@type"       : "WebSite"
		, "name"        : ctx.projectName + (ctx.projectVersion ? " v" + ctx.projectVersion : "")
		, "description" : indexDescription
	};

	if(ctx.baseUrl){
		siteNode.url = ctx.baseUrl.replace(/\/+$/, "") + "/index.html";
	}

	if(ctx.projectVersion){
		siteNode.version = String(ctx.projectVersion);
	}

	var siteLd = '<script type="application/ld+json">'
		+ JSON.stringify(siteNode, null, "\t").replace(/<\//g, "<\\/")
		+ '</script>';

	return `
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

		
    	<title>${ctx.projectName}${ctx.projectVersion ? " v" + ctx.projectVersion : ""} Documentation</title>
		<meta name="description" content="${indexDescription}">
		<meta name="generator" content="Documon">
		${canonical}
		<link rel="alternate" type="text/plain" href="llms.txt" title="llms.txt">
		<link rel="alternate" type="application/json" href="model.json" title="model.json">

		<!-- Open Graph / social -->
		<meta property="og:type" content="website">
		<meta property="og:title" content="${ctx.projectName}${ctx.projectVersion ? " v" + ctx.projectVersion : ""} Documentation">
		<meta property="og:description" content="${indexDescription}">
		<meta name="twitter:card" content="summary">

		${siteLd}

		 <!-- Normalize -->
	    <link rel="stylesheet" href="${assetsFolder}/vendor/normalize.css">

		<!-- Font: Font Awsome -->
	    <link rel="stylesheet" href="${assetsFolder}/fonts/font-awesome/css/font-awesome.min.css">

		<!-- Font: Fira Sans 
	    <link rel="stylesheet" href="${assetsFolder}/fonts/Fira_Sans/FiraSans.css">
	    -->

		<!-- layout -->
	    <link rel="stylesheet" href="${assetsFolder}/vendor/layout/layout.css">
	    <script src="${assetsFolder}/vendor/layout/layout.js"></script>

	    <!-- menutree -->
	    <link rel="stylesheet" href="${assetsFolder}/js/documon/menutree/MenuTree.css">
	    <script src="${assetsFolder}/js/documon/menutree/MenuTree.js"></script>

   <!-- =====================
	    menu & search data
	    ====================== -->
	    <script src="_menuData.js"></script>
	    <script src="_searchData.js"></script>


	    <!-- theme -->
	    <link href="${assetsFolder}/css/home.css" rel="stylesheet">
	    <link href="${assetsFolder}/css/tabs/tabs.css" rel="stylesheet">
	    <script src="${assetsFolder}/js/documon/Storage.js"></script>
	    <script src="${assetsFolder}/js/documon/Draggable.js"></script>
	    <script src="${assetsFolder}/js/documon/Access.js"></script>
	    <script src="${assetsFolder}/js/documon/Docutils.js"></script>
	    <script src="${assetsFolder}/js/documon/Main.js"></script>
	    <script src="${assetsFolder}/js/documon/TabManager.js"></script>
	    <script src="${assetsFolder}/js/documon/PageManager.js"></script>
	    <script src="${assetsFolder}/js/documon/Search.js"></script>

	    ${Tgati(ctx.gati)}

	</head>



	<body>



		<div data-layout="col" data-noscroll data-noresize >

			<!-- header -->
			<div id="headerPanel" data-layout="row" data-size="25" data-noscroll data-noresize >

				<!-- header left -->
				<div class="header header-left">
					<a href="{{projectUrl}}" target="_blank">
					<div class="title">${ctx.projectName}</div>
		            <div class="version">${ctx.projectVersion}</div>
		            </a>
				</div>

				<!-- header center -->
				<div class="header header-center" >
				</div>

				<!-- header right -->
				<div class="header header-right" >
					<div class="access-box">
			        	<input id="cb_inherits" type="checkbox" checked  /><label for="cb_inherits"> Inhereted</label>
			        	<input id="cb_private" type="checkbox" checked /><label for="cb_private"> Private</label>
			        	<input id="cb_protected" type="checkbox" checked /><label for="cb_protected"> Protected</label>
			        	<!--<input type="checkbox" id="cb_depreciated" onclick="documon.Main.setAccess()" /><label for="cb_depreciated"> Depreciated</label>-->
			         </div>
				</div>

			</div>

			<!-- main -->
			<div id="mainPanel" data-layout="row" data-noscroll data-noresize >

				<!-- left side -->
				<div id="leftPanel" data-layout="col" data-size="200" data-noscroll data-remember>

					<!-- Menu Tree -->
					<div id="menuPanel" data-layout="row" >
					
					</div>

					<!-- Search Panel -->
					<div id="searchPanel" data-layout="row" data-size="50" data-fixed >

						<div id="searchBox">
							<input type="text" id="searchText" placeholder="search" /><span id="searchButton" class="fa"></span>
						</div>
					
						<div id="searchResults"></div>
					
					</div>
				
				</div>

				<!-- content -->
				<div id="contentPanel" data-layout="col">
					<div id="tabPanel" data-layout="row" data-size="34" data-noscroll data-noresize>
					
					</div>

					<div id="pagePanel" data-layout="row" data-noscroll>
					
					</div>
				</div>
			
			</div>

		</div>

	</body>

</html>
`;
}

function render(ctx) {
	return build(ctx);
}

module.exports = render;