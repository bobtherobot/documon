{
  "name": "documon",
  "version": "2.7.0",
  "description": "A documentation system for mortals. Use with any language. Zero dependencies, AI-agent friendly.",
  "main": "index.js",
  "bin": {
    "documon": "index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "index.js",
    "src/",
    "template/",
    "TAGS.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "test": "node test/run.js",
    "check": "node index.js --check -i src",
    "docs": "node index.js -i src -o . -n Documon -v 2.7.0 -p"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobtherobot/documon.git"
  },
  "keywords": [
    "documentation",
    "doc",
    "docs",
    "documentation-generator",
    "api-documentation",
    "static-site",
    "YUIdoc",
    "javadoc",
    "JSdoc",
    "jsdoc-alternative",
    "llms-txt",
    "ai",
    "ai-friendly",
    "agent",
    "llm",
    "zero-dependencies",
    "polyglot",
    "any-language"
  ],
  "author": "mike gieson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bobtherobot/documon/issues"
  },
  "homepage": "https://www.documon.net"
}
